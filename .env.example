MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=celery
MONGO_AUTH_SOURCE=admin
MONGO_USER=root
MONGO_PASS=example
QUEUE_URL=queue:5672/myvhost
QUEUE_USER=user
QUEUE_PASS=password
APP_ENV=
# off | log | enforce. See rhythm_api/app_scope.py. Defaults to log.
APP_SCOPE_MODE=log
# Comma-separated token subjects that may reach every app's workflows
APP_SCOPE_ADMIN_SUBJECTS=
